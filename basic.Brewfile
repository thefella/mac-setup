# Install directory
cask_args appdir: "/Applications"


# Taps
tap "alielsokary/tap", trusted: { casks: ["caskhub"] }
#tap "theboredteam/boring-notch", "https://github.com/TheBoredTeam/homebrew-boring-notch"


# Install packages
brew "cask"
brew "mas"

brew "age"
brew "curl"
brew "exiftool"
brew "ffmpeg"
brew "git"
brew "git-crypt"
brew "git-lfs"
brew "gnupg"
brew "mackup"
brew "mkcert"
brew "node"
brew "openssl"
brew "pinentry-mac"
brew "thefuck"
brew "wget"


# Install priority apps
cask "1password"
cask "alfred"
cask "appcleaner"
cask "bettertouchtool"
cask "TheBoredTeam/boring-notch/boring-notch", trusted: true
cask "do-not-disturb"
cask "fuse-t"
cask "keka"
cask "lulu"
cask "macfuse"
cask "mole-app"
cask "moom"
cask "numi"
cask "oversight"
cask "proton-drive"
cask "protonvpn"
cask "quicklook-video"
cask "ransomwhere"
cask "thaw"
cask "updatest"
cask "vivaldi"
cask "vorssaint"

brew "nextdns"
brew "tailscale"


# Install priority app store apps
mas "1Password for Safari", id: 1569813296
#mas "NextDNS", id: 1464122853
mas "uBlock Origin Lite", id: 6745342698


# Install other apps
cask "TheBoredTeam/boring-notch/boring-notch"
cask "caskhub"
cask "cryptomator"
cask "ente"
cask "github"
cask "grandperspective"
cask "ivpn"
cask "knockknock"
cask "netiquette"
cask "onionshare"
cask "shifty"
cask "signal"
cask "spotify"
cask "taskexplorer"
cask "telegram"
cask "tor-browser"
cask "veracrypt-fuse-t"
cask "vivid-app"
cask "vlc"
cask "whatsapp"


# Install other app store apps
mas "Bear", id: 1091189122
mas "Bitdefender Virus Scanner", id: 500154009
mas "Encrypto", id: 935235287
mas "FE File Explorer Pro", id: 1466198841
mas "Keynote", id: 361285480
mas "Prompt", id: 1594420480
mas "Speedtest", id: 1153157709


# Install fonts
cask "font-commissioner"
cask "font-bitter"
cask "font-jetbrains-mono-nerd-font"
cask "font-iosevka-term-nerd-font"
cask "font-iosevka-nerd-font"
cask "font-roboto-mono-nerd-font"
cask "font-0xproto-nerd-font"
